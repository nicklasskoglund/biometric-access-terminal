# Template for Streamlit secrets. Copy to .streamlit/secrets.toml (gitignored)
# for local use, or paste into "Settings -> Secrets" on Streamlit Community Cloud.
#
# TURN server for WebRTC: required on Community Cloud, optional locally.
# Without this section the app falls back to Google's public STUN server.
# Values come from the ExpressTURN dashboard. The free plan supports
# TCP and UDP on port 3478 only.
#
# These are static credentials and are visible in the browser. Rotate them
# with "Refresh Credentials" in the ExpressTURN dashboard if they are abused.
[turn]
urls = [
    "turn:YOUR-EXPRESSTURN-SERVER:3478",
    "turn:YOUR-EXPRESSTURN-SERVER:3478?transport=tcp",
]
username = "your-expressturn-username"
credential = "your-expressturn-password"
